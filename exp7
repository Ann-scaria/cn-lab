import java.io.*;           // BufferedReader, PrintWriter - stream I/O
import java.net.*;          // Socket - the client side of a TCP connection
import java.util.Scanner;   // Scanner - to read what the user types

public class ChatClient {

    public static void main(String[] args) throws Exception {

        // Open a TCP connection to the server.
        // "localhost" = this same machine; replace it with the server's
        // IP address (e.g. "192.168.1.5") when testing across computers.
        // 5000 must match the port the server is listening on.
        Socket socket = new Socket("localhost", 5000);

        // Stream for reading messages SENT BY the server.
        BufferedReader in = new BufferedReader(
                new InputStreamReader(socket.getInputStream()));

        // Stream for sending messages TO the server.
        // "true" enables auto-flush so messages are not delayed.
        PrintWriter out = new PrintWriter(
                socket.getOutputStream(), true);

        // Scanner reads lines typed on the keyboard (standard input).
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter your name: ");
        String name = sc.nextLine();

        // The first line sent must be the nickname - the server
        // expects this and uses it to label our messages.
        out.println(name);

        /* A separate RECEIVER thread is essential. Reading from the





            keyboard and reading from the network both BLOCK. With only
            one thread the program would freeze while waiting for input
            and could never display incoming messages. Two threads let
            both happen at the same time. */
         Thread receive = new Thread(() -> {

               try {

                  String msg;

                  // Keep reading lines from the server until the
                  // connection is closed (readLine() returns null).
                  while ((msg = in.readLine()) != null) {

                       System.out.println(msg);   // show it on the screen

                  }

               } catch (Exception e) {
                   // Connection closed or lost - simply stop receiving.
               }

         });

         receive.start();    // launch the receiver thread

         // MAIN thread: keeps sending. It reads a line from the keyboard
         // and forwards it to the server, which broadcasts it to others.
         while (true) {

               String message = sc.nextLine();

               out.println(message);

         }
    }
}
